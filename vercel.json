{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/static/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/static/js/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/static/admin/$1"
    },
    {
      "src": "/store/(.*)",
      "dest": "/static/store/$1"
    },
    {
      "src": "/customer/(.*)",
      "dest": "/static/customer/$1"
    },
    {
      "src": "/cashier/(.*)",
      "dest": "/static/cashier/$1"
    },
    {
      "src": "/shipping/(.*)",
      "dest": "/static/shipping/$1"
    },
    {
      "src": "/inventory/(.*)",
      "dest": "/static/inventory/$1"
    },
    {
      "src": "/html5-qrcode/(.*)",
      "dest": "/static/html5-qrcode/$1"
    },
    {
      "src": "/(.*\\.html)$",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*\\.css)$",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*\\.js)$",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*\\.png)$",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*\\.jpg)$",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*\\.ico)$",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
